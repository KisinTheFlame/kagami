{
  "name": "@kagami/gba-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "pretest": "pnpm --filter \"@kagami/gba-service^...\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "start": "node dist/index.js",
    "db:generate": "PRISMA_PACKAGE_DIR=apps/gba PRISMA_CONFIG_KEY=services.gba.databaseUrl bash ../../scripts/prisma.sh generate",
    "db:migrate:dev": "PRISMA_PACKAGE_DIR=apps/gba PRISMA_CONFIG_KEY=services.gba.databaseUrl bash ../../scripts/prisma.sh migrate dev",
    "db:migrate:deploy": "PRISMA_PACKAGE_DIR=apps/gba PRISMA_CONFIG_KEY=services.gba.databaseUrl bash ../../scripts/prisma.sh migrate deploy",
    "db:migrate:status": "PRISMA_PACKAGE_DIR=apps/gba PRISMA_CONFIG_KEY=services.gba.databaseUrl bash ../../scripts/prisma.sh migrate status",
    "db:migrate:resolve": "PRISMA_PACKAGE_DIR=apps/gba PRISMA_CONFIG_KEY=services.gba.databaseUrl bash ../../scripts/prisma.sh migrate resolve"
  },
  "dependencies": {
    "@kagami/gba-api": "workspace:*",
    "@kagami/http": "workspace:*",
    "@kagami/kernel": "workspace:*",
    "@kagami/observatory-client": "workspace:*",
    "@kagami/oss-api": "workspace:*",
    "@kagami/rpc-client": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.6.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.6.2",
    "pngjs": "^7.0.0",
    "prisma": "^7.6.0",
    "retroemu": "0.4.8",
    "romdev-platform-gba": "0.11.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
