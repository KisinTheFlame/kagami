{
  "name": "@kagami/oss",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "db:generate": "PRISMA_PACKAGE_DIR=apps/oss PRISMA_CONFIG_KEY=services.oss.databaseUrl bash ../../scripts/prisma.sh generate",
    "db:migrate:dev": "PRISMA_PACKAGE_DIR=apps/oss PRISMA_CONFIG_KEY=services.oss.databaseUrl bash ../../scripts/prisma.sh migrate dev",
    "db:migrate:deploy": "PRISMA_PACKAGE_DIR=apps/oss PRISMA_CONFIG_KEY=services.oss.databaseUrl bash ../../scripts/prisma.sh migrate deploy",
    "db:migrate:status": "PRISMA_PACKAGE_DIR=apps/oss PRISMA_CONFIG_KEY=services.oss.databaseUrl bash ../../scripts/prisma.sh migrate status",
    "db:migrate:resolve": "PRISMA_PACKAGE_DIR=apps/oss PRISMA_CONFIG_KEY=services.oss.databaseUrl bash ../../scripts/prisma.sh migrate resolve"
  },
  "dependencies": {
    "@kagami/config": "workspace:*",
    "@kagami/http": "workspace:*",
    "@kagami/kernel": "workspace:*",
    "@kagami/oss-api": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.6.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.6.2",
    "prisma": "^7.6.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
