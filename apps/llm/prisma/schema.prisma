generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

// llm 独占的 SQLite 库（epic #539 子 issue 3，与主库 kagami.db 物理分离）。
// 五张表从 packages/persistence 的共享 schema 原样搬入（表名 / 列名 / 索引名不变）。
// 历史数据搬迁与主库旧表 DROP 均已完成（#539 子 issue 5），本库是这些表的唯一归属。

// LLM 请求审计：一行 = 一次 provider 调用（console 查询用；agent 的 tool_result 只留摘要，
// 完整原文在此可查）。
//
// **请求体不再行内存储（#612）**：ReAct 每轮重发全部历史，逐轮存完整副本让单会话累计写入
// 呈 O(轮数²)；实测 23104 条 message 引用里只有 11% 是唯一的。故 `messages` 逐条进内容寻址的
// `llm_blob`，行内只留 `messageRefs`（有序 blob id）与 `requestSkeleton`（非 messages 字段 +
// system/tools 的 blob 引用），写入降到 O(轮数)。`native_request_payload` 是 request 的另一份
// provider wire 序列化、占了改动前一半空间，直接删列不再落库；**`native_error` /
// `native_response_payload` 保留**——它们 O(1)/行，且是 provider 侧 4xx 真因的唯一落点。
model LlmChatCall {
  id                    Int      @id @default(autoincrement())
  requestId             String   @map("request_id")
  seq                   Int      @default(1)
  provider              String
  model                 String
  // 调用归因（自由 string，如 agent / contextSummarizer / vision）；chatDirect 无归因 → null。
  scene                 String?
  extension             Json?
  status                String
  // request 去掉 messages / system / tools 后原样保留的字段，外加 systemBlobId / toolsBlobId。
  // 刻意不是白名单：将来 request 加字段会自动无损带上，不必回来改 schema。
  requestSkeleton       Json     @map("request_skeleton")
  // big-endian packed Uint32：messages 的有序 blob id，长度必然是 4 的倍数。
  messageRefs           Bytes    @map("message_refs")
  responsePayload       Json?    @map("response_payload")
  nativeResponsePayload Json?    @map("native_response_payload")
  error                 Json?
  nativeError           Json?    @map("native_error")
  latencyMs             Int?     @map("latency_ms")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([requestId, seq], map: "llm_chat_call_request_id_seq_uq")
  @@index([provider, model], map: "llm_chat_call_provider_model_idx")
  @@index([createdAt], map: "llm_chat_call_created_at_idx")
  @@index([scene, createdAt], map: "llm_chat_call_scene_created_at_idx")
  @@map("llm_chat_call")
}

// 内容寻址的 payload 分片存储（#612）：一行 = 一段唯一内容（一条 message / 一份 system /
// 一份 tools）。`hash` 是**未压缩原始字节**的 sha256，`bytes` 按 `codec` 存（zstd 压缩结果
// 不小于原始时退回 raw），故 hash 与实存字节的对应关系恒定、不随压缩策略变化。
//
// 回收走每日 mark-sweep（`llm-blob-gc-task.ts`），不做 refcount：refcount 要与 retention 的
// 分块删耦合且漂移后不自愈，mark-sweep 每天从事实重算。
//
// `lastUsedAt` 是 mark-sweep 的安全带，不是统计字段：被 retention 清空引用的 blob（复用率最高的
// system prompt 首当其冲）可能在 mark 之后、sweep 之前被新调用重新引用，只看 live 集合会把它扫掉，
// 留下永远 500 的详情页。GC 因此只回收「至少一个宽限窗口没被引用过」的 blob，命中即续期。
// 与同库 claude_file_cache 的 lastUsedAt 回收是同一套路数。
model LlmBlob {
  id        Int      @id @default(autoincrement())
  hash      Bytes    @unique(map: "llm_blob_hash_uq")
  codec     String
  // 未压缩原始字节数；与 storedBytes 之比即压缩率，是这张表唯一的容量观测口径。
  sizeBytes   Int    @map("size_bytes")
  // 实际入库字节数（= LENGTH(bytes)）。冗余一列换 GC 回收量统计走 Prisma 类型化查询，
  // 不必为一个 LENGTH() 掉进 $queryRaw。
  storedBytes Int    @map("stored_bytes")
  bytes       Bytes
  createdAt   DateTime @default(now()) @map("created_at")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")

  @@index([lastUsedAt], map: "llm_blob_last_used_at_idx")
  @@map("llm_blob")
}

model OauthSession {
  id            Int       @id @default(autoincrement())
  provider      String
  accountId     String?   @map("account_id")
  email         String?
  accessToken   String?   @map("access_token")
  refreshToken  String?   @map("refresh_token")
  idToken       String?   @map("id_token")
  expiresAt     DateTime? @map("expires_at")
  lastRefreshAt DateTime? @map("last_refresh_at")
  status        String
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  @@unique([provider], map: "oauth_session_provider_uq")
  @@index([status, updatedAt], map: "oauth_session_status_updated_at_idx")
  @@map("oauth_session")
}

model OauthState {
  id           Int       @id @default(autoincrement())
  state        String    @unique(map: "oauth_state_state_uq")
  codeVerifier String    @map("code_verifier")
  redirectUri  String    @map("redirect_uri")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([expiresAt], map: "oauth_state_expires_at_idx")
  @@map("oauth_state")
}

model EmbeddingCache {
  id                   Int      @id @default(autoincrement())
  provider             String
  model                String
  taskType             String   @map("task_type")
  outputDimensionality Int      @map("output_dimensionality")
  text                 String
  textHash             String   @map("text_hash")
  embedding            String
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([provider, model, taskType, outputDimensionality, textHash], map: "embedding_cache_provider_model_task_output_text_hash_uq")
  @@index([createdAt], map: "embedding_cache_created_at_idx")
  @@map("embedding_cache")
}

// claude-code 图片 File API 缓存：图片内容 sha256 → 已上传的 Anthropic file_id。
// 让同一张图（跨轮次 / 跨 kagami-llm 重启 / 跨会话）只上传一次。Files API 文件不过期
// （persist until deleted），故由 llm 进程的每日 GC 按 lastUsedAt 回收（#433）。仅 claude-code provider 用。
model ClaudeFileCache {
  contentSha256 String   @id @map("content_sha256")
  fileId        String   @map("file_id")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at")
  lastUsedAt    DateTime @default(now()) @map("last_used_at")

  @@index([lastUsedAt], map: "claude_file_cache_last_used_at_idx")
  @@map("claude_file_cache")
}
